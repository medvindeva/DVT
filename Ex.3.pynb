    },
    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "from sklearn.preprocessing import MinMaxScaler, LabelEncoder\n",
        "\n",
        "# Load FIFA World Cup 2026 Player Performance dataset\n",
        "df = pd.read_csv(\"fifa_world_cup_2026_player_performance.csv\")\n",
        "\n",
        "print(\"DATASET SHAPE\")\n",
        "print(df.shape)\n",
        "\n",
        "\n",
        "print(\"\\nMISSING VALUES\")\n",
        "missing_values = df.isnull().sum()\n",
        "print(missing_values[missing_values > 0])\n",
        "\n",
        "print(\"\\nTOTAL MISSING VALUES =\", df.isnull().sum().sum())\n",
        "\n",
        "\n",
        "\n",
        "print(\"\\nDUPLICATE RECORDS\")\n",
        "print(\"Number of duplicate records =\", df.duplicated().sum())\n",
        "\n",
        "df.drop_duplicates(inplace=True)\n",
        "\n",
        "print(\"Dataset shape after removing duplicates =\", df.shape)\n",
        "\n",
        "\n",
        "\n",
        "print(\"\\nOUTLIER DETECTION USING IQR\")\n",
        "\n",
        "Q1 = df[\"market_value_eur\"].quantile(0.25)\n",
        "Q3 = df[\"market_value_eur\"].quantile(0.75)\n",
        "\n",
        "IQR = Q3 - Q1\n",
        "\n",
        "lower = Q1 - 1.5 * IQR\n",
        "upper = Q3 + 1.5 * IQR\n",
        "\n",
        "print(\"Q1 =\", Q1)\n",
        "print(\"Q3 =\", Q3)\n",
        "print(\"IQR =\", IQR)\n",
        "print(\"Lower Limit =\", lower)\n",
        "print(\"Upper Limit =\", upper)\n",
        "\n",
        "outliers = df[\n",
        "    (df[\"market_value_eur\"] < lower) |\n",
        "    (df[\"market_value_eur\"] > upper)\n",
        "]\n",
        "\n",
        "print(\"\\nOUTLIERS\")\n",
        "print(outliers[[\"player_name\", \"market_value_eur\"]].head(10))\n",
        "\n",
        "print(\"\\nTotal number of outliers =\", len(outliers))\n",
        "\n",
        "\n",
        "\n",
        "print(\"\\nNORMALIZATION\")\n",
        "\n",
        "scaler = MinMaxScaler()\n",
        "\n",
        "df[\"market_value_normalized\"] = scaler.fit_transform(\n",
        "    df[[\"market_value_eur\"]]\n",
        ")\n",
        "\n",
        "print(\n",
        "    df[\n",
        "        [\"player_name\",\n",
        "         \"market_value_eur\",\n",
        "         \"market_value_normalized\"]\n",
        "    ].head()\n",
        ")\n",
        "\n",
        "\n",
        "\n",
        "print(\"\\nLABEL ENCODING\")\n",
        "\n",
        "encoder = LabelEncoder()\n",
        "\n",
        "df[\"position_encoded\"] = encoder.fit_transform(\n",
        "    df[\"position\"]\n",
        ")\n",
        "\n",
        "print(\n",
        "    df[\n",
        "        [\"player_name\",\n",
        "         \"position\",\n",
        "         \"position_encoded\"]\n",
        "    ].head()\n",
        ")\n",
        "\n",
        "print(\"\\nENCODING MAPPING\")\n",
        "\n",
        "for value, code in zip(\n",
        "    encoder.classes_,\n",
        "    encoder.transform(encoder.classes_)\n",
        "):\n",
        "    print(value, \"=\", code)\n",
        "\n",
        "\n",
        "\n",
        "print(\"\\nONE-HOT ENCODING\")\n",
        "\n",
        "one_hot = pd.get_dummies(df[\"position\"])\n",
        "\n",
        "print(one_hot.head())\n",
        "\n",
        "print(\"\\nDATA CLEANING AND TRANSFORMATION COMPLETED\")"
      ],
